<%- include('../partials/encabezado') %>
<%
const estados = { disponible: 'Disponible', rentado: 'Rentado (en domicilio)', en_limpieza: 'En limpieza', en_reparacion: 'En reparación', baja: 'Dado de baja' }
const color = { disponible: 'success', rentado: 'primary', en_limpieza: 'info', en_reparacion: 'warning', baja: 'secondary' }
%>
<div class="pt-4 pb-2 mb-3 border-bottom">
  <h1 class="h3 mb-0">Equipo de brincolines</h1>
  <p class="text-body-secondary mb-0">Si un brincolín se daña antes de tiempo, repórtalo: sus rentas próximas quedan para que el cliente elija reembolso, otra fecha u otro modelo.</p>
</div>

<%- include('_nav') %>
<%- include('../partials/errores', { errores }) %>

<div class="row g-3">
  <% filas.forEach(b => { %>
  <div class="col-md-6 col-xl-4">
    <div class="card h-100 border-0 shadow-sm <%= b.estado === 'baja' ? 'opacity-75' : '' %>">
      <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
          <h2 class="h6 mb-0"><%= b.nombre %></h2>
          <span class="badge text-bg-<%= color[b.estado] %>"><%= estados[b.estado] %></span>
        </div>
        <div class="small text-body-secondary mb-2"><%= Number(b.largo_m) %> × <%= Number(b.ancho_m) %> × <%= Number(b.alto_m) %> m · <%= f.dinero(b.precio_dia) %> + garantía <%= f.dinero(b.garantia) %></div>
        <div class="small mb-3">
          <i class="bi bi-calendar-event"></i> <%= b.proximas %> renta(s) próxima(s)
          <% if (b.pendientes > 0) { %> · <a href="/brincolines/rentas?filtro=atencion" class="text-danger fw-semibold"><%= b.pendientes %> por resolver</a><% } %>
        </div>
        <div class="mt-auto">
          <% if (['disponible', 'en_limpieza'].includes(b.estado)) { %>
          <form method="post" action="/brincolines/equipo/<%= b.id %>/dano" class="d-grid gap-2"
                data-preguntar="Se marca el daño de <%= b.nombre %>. Sus rentas próximas quedan pendientes para que el cliente elija.">
            <input name="motivo" maxlength="200" class="form-control form-control-sm" placeholder="¿Qué le pasó?" aria-label="Daño de <%= b.nombre %>" required>
            <div class="d-flex gap-2">
              <select name="estado" class="form-select form-select-sm" aria-label="Qué hacer con <%= b.nombre %>">
                <option value="en_reparacion">A reparación</option>
                <option value="baja">Dar de baja</option>
              </select>
              <button class="btn btn-sm btn-outline-danger text-nowrap">Reportar daño</button>
            </div>
          </form>
          <% } else if (b.estado === 'en_reparacion') { %>
          <form method="post" action="/brincolines/equipo/<%= b.id %>/reparado" data-preguntar="<%= b.nombre %> regresó de reparación: pasa a Limpieza para revisarlo.">
            <button class="btn btn-sm btn-outline-success w-100"><i class="bi bi-wrench-adjustable"></i> Regresó de reparación</button>
          </form>
          <% } else if (b.estado === 'rentado') { %>
          <p class="small text-body-secondary mb-0">Está en casa de un cliente. Se revisa cuando lo recojan.</p>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <% }) %>
</div>

<%- include('../partials/pie', { scriptsExtra: ['/js/brincolines.js'] }) %>
