<% if (!comandas.length) { %>
  <div class="col-12">
    <div class="card border-0 shadow-sm"><div class="card-body p-5 text-center text-body-secondary">
      <i class="bi bi-check2-all fs-1 d-block mb-2"></i>No hay nada listo por entregar.
    </div></div>
  </div>
<% } %>
<% comandas.forEach(c => { %>
<div class="col-md-6 col-xl-4">
  <div class="card border-0 shadow-sm h-100">
    <div class="card-header d-flex flex-wrap align-items-center gap-2 bg-transparent">
      <span class="fs-4 fw-bold">#<%= c.folio %></span>
      <span class="badge <%= c.para_llevar ? 'text-bg-primary' : 'text-bg-light border' %> fs-6"><%= c.para_llevar ? 'PARA LLEVAR' : `Mesa ${c.mesa}` %></span>
      <span class="ms-auto small text-body-secondary"><%= c.cliente %></span>
    </div>
    <div class="card-body pt-2">
      <ul class="list-unstyled mb-2">
        <% c.articulos.forEach(a => { %>
        <li class="d-flex justify-content-between align-items-start gap-2 py-1 border-bottom">
          <div>
            <span class="fw-semibold"><%= a.descripcion %></span>
            <% a.quitar.forEach(n => { %><div class="small text-danger-emphasis">Sin <%= n %></div><% }) %>
            <% a.extras.forEach(n => { %><div class="small text-success-emphasis">+ <%= n %></div><% }) %>
            <div class="small text-body-secondary">Listo hace <%= a.minutos %> min</div>
          </div>
          <form method="post" action="/caja/articulos/<%= a.id %>/entregar" data-ajax>
            <button class="btn btn-sm btn-outline-success text-nowrap"><i class="bi bi-check2"></i> Entregado</button>
          </form>
        </li>
        <% }) %>
      </ul>
      <% if (c.en_cocina > 0) { %>
        <div class="small text-warning-emphasis mb-2"><i class="bi bi-hourglass-split"></i> <%= c.en_cocina %> artículo(s) de esta comanda siguen en cocina.</div>
      <% } %>
      <form method="post" action="/caja/comandas/<%= c.id %>/entregar" data-ajax>
        <button class="btn btn-marca w-100"><i class="bi bi-check2-all"></i> Entregar todo lo listo</button>
      </form>
    </div>
  </div>
</div>
<% }) %>
