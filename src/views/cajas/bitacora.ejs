<%- include('../partials/encabezado') %>

<div class="pt-4 pb-2 mb-3 border-bottom">
  <h1 class="h3 mb-0">Bitácora del administrador</h1>
  <p class="text-body-secondary mb-0">Cierres de turno forzados y reasignaciones de horario, con el motivo.</p>
</div>

<%- include('_nav') %>
<%- include('../partials/errores', { errores }) %>

<section class="card border-0 shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead><tr><th>Fecha</th><th>Acción</th><th>Administrador</th><th>Motivo</th></tr></thead>
      <tbody>
        <% const ACCIONES = { cerrar_turno_forzado: 'Cierre de turno forzado', reasignar_horario: 'Reasignación de horario' } %>
        <% if (!filas.length) { %><tr><td colspan="4" class="text-center text-body-secondary py-4">Todavía no hay nada en la bitácora.</td></tr><% } %>
        <% filas.forEach(b => { %>
        <tr>
          <td class="text-nowrap"><%= f.fechaCorta(b.creado_en) %></td>
          <td><span class="badge text-bg-warning-subtle text-warning-emphasis"><%= ACCIONES[b.accion] || b.accion %></span></td>
          <td><%= b.admin %></td>
          <td><%= b.motivo %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<%- include('../partials/pie') %>
