<%- include('../partials/encabezado') %>
<div class="pt-4 pb-2 mb-3 border-bottom d-flex flex-wrap justify-content-between align-items-end gap-2">
  <div>
    <h1 class="h3 mb-0">Gráficas del negocio</h1>
    <p class="text-body-secondary mb-0">Ventas por servicio y por periodo, y devoluciones. Garantías y cuotas no cuentan como venta.</p>
  </div>
  <form method="get" class="d-flex flex-wrap gap-2" id="filtros-graficas">
    <input type="date" name="desde" value="<%= filtros.desde %>" class="form-control w-auto" aria-label="Desde">
    <input type="date" name="hasta" value="<%= filtros.hasta %>" class="form-control w-auto" aria-label="Hasta">
    <select name="agrupar" class="form-select w-auto" aria-label="Agrupar por">
      <option value="dia" <%= filtros.agrupar === 'dia' ? 'selected' : '' %>>Por día</option>
      <option value="mes" <%= filtros.agrupar === 'mes' ? 'selected' : '' %>>Por mes</option>
    </select>
    <button class="btn btn-marca">Ver</button>
  </form>
</div>

<%- include('_nav') %>

<div class="row g-3 mb-4 text-center">
  <% porServicio.forEach(s => { %>
  <div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body p-3">
    <div class="small text-body-secondary"><%= s.caja %></div>
    <div class="fs-4 fw-semibold"><%= f.dinero(s.ventas) %></div>
    <div class="small"><span class="text-danger">−<%= f.dinero(s.devoluciones) %></span> en <%= s.n_devoluciones %> devolución(es)</div>
  </div></div></div>
  <% }) %>
</div>

<div class="row g-4">
  <div class="col-xl-5"><section class="card border-0 shadow-sm h-100"><div class="card-body p-4">
    <h2 class="h6 text-uppercase texto-seccion mb-3">Ventas por servicio</h2><div class="grafica"><canvas id="g-servicio" aria-label="Ventas y devoluciones por servicio" role="img"></canvas></div>
  </div></section></div>
  <div class="col-xl-7"><section class="card border-0 shadow-sm h-100"><div class="card-body p-4">
    <h2 class="h6 text-uppercase texto-seccion mb-3">Ventas por <%= filtros.agrupar === 'mes' ? 'mes' : 'día' %></h2><div class="grafica"><canvas id="g-periodo" aria-label="Ventas por periodo y servicio" role="img"></canvas></div>
  </div></section></div>
  <div class="col-12"><section class="card border-0 shadow-sm"><div class="card-body p-4">
    <h2 class="h6 text-uppercase texto-seccion mb-3">Devoluciones por <%= filtros.agrupar === 'mes' ? 'mes' : 'día' %></h2><div class="grafica"><canvas id="g-devoluciones" aria-label="Devoluciones por periodo" role="img"></canvas></div>
  </div></section></div>
</div>

<script type="application/json" id="datos-graficas"><%- JSON.stringify({ filtros, cajas, periodos, ventas, devoluciones, porServicio }).replace(/</g, '\\u003c') %></script>
<%- include('../partials/pie', { scriptsExtra: ['/vendor/chart.js/chart.umd.min.js', '/js/cajas.js'] }) %>
