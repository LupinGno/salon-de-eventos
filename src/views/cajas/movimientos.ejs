<%- include('../partials/encabezado') %>
<%
const medios = { efectivo: 'Efectivo', tarjeta: 'Tarjeta', transferencia: 'Transferencia' }
const qs = new URLSearchParams(Object.entries(filtros).filter(([, v]) => v !== '' && v !== null)).toString()
%>
<div class="pt-4 pb-2 mb-3 border-bottom d-flex flex-wrap justify-content-between align-items-end gap-2">
  <div>
    <h1 class="h3 mb-0">Movimientos de caja</h1>
    <p class="text-body-secondary mb-0">Ventas, devoluciones en negativo, cuotas, garantías y extras de <%= cajas.length === 1 ? 'tu caja' : 'tus cajas' %>.</p>
  </div>
  <a href="/cajas/movimientos.pdf?<%= qs %>" target="_blank" class="btn btn-outline-primary" id="exportar-pdf"><i class="bi bi-file-earmark-pdf"></i> Exportar a PDF</a>
</div>

<%- include('_nav') %>
<%- include('../partials/errores', { errores }) %>

<form method="get" class="card border-0 shadow-sm mb-4" id="filtros">
  <div class="card-body row g-2 align-items-end">
    <div class="col-sm-6 col-lg-3"><label class="form-label small mb-1" for="f-caja">Caja</label>
      <select id="f-caja" name="caja" class="form-select"><% if (cajas.length > 1) { %><option value="">Todas</option><% } %>
        <% cajas.forEach(c => { %><option value="<%= c.id %>" <%= filtros.caja === c.id ? 'selected' : '' %>><%= c.nombre %></option><% }) %></select></div>
    <div class="col-6 col-lg-2"><label class="form-label small mb-1" for="f-desde">Desde</label><input id="f-desde" type="date" name="desde" value="<%= filtros.desde %>" class="form-control"></div>
    <div class="col-6 col-lg-2"><label class="form-label small mb-1" for="f-hasta">Hasta</label><input id="f-hasta" type="date" name="hasta" value="<%= filtros.hasta %>" class="form-control"></div>
    <div class="col-6 col-lg-2"><label class="form-label small mb-1" for="f-tipo">Tipo</label>
      <select id="f-tipo" name="tipo" class="form-select"><option value="">Todos</option>
        <% Object.entries(TIPOS).forEach(([k, v]) => { %><option value="<%= k %>" <%= filtros.tipo === k ? 'selected' : '' %>><%= v %></option><% }) %></select></div>
    <div class="col-6 col-lg-2"><label class="form-label small mb-1" for="f-medio">Medio</label>
      <select id="f-medio" name="medio" class="form-select"><option value="">Todos</option>
        <% Object.entries(medios).forEach(([k, v]) => { %><option value="<%= k %>" <%= filtros.medio === k ? 'selected' : '' %>><%= v %></option><% }) %></select></div>
    <div class="col-lg-1 d-grid"><button class="btn btn-marca"><i class="bi bi-funnel"></i></button></div>
  </div>
</form>

<div class="row g-3 mb-4 text-center">
  <div class="col-6 col-lg-3"><div class="card border-0 shadow-sm"><div class="card-body p-3"><div class="small text-body-secondary">Entradas</div><div class="fs-5 fw-semibold"><%= f.dinero(totales.entradas) %></div></div></div></div>
  <div class="col-6 col-lg-3"><div class="card border-0 shadow-sm"><div class="card-body p-3"><div class="small text-body-secondary">Salidas</div><div class="fs-5 fw-semibold text-danger"><%= f.dinero(-totales.salidas) %></div></div></div></div>
  <div class="col-6 col-lg-3"><div class="card border-0 shadow-sm"><div class="card-body p-3"><div class="small text-body-secondary">Neto</div><div class="fs-5 fw-semibold"><%= f.dinero(totales.neto) %></div></div></div></div>
  <div class="col-6 col-lg-3"><div class="card border-0 shadow-sm"><div class="card-body p-3 small text-start">
    <% Object.entries(medios).forEach(([k, v]) => { %><div class="d-flex justify-content-between"><span><%= v %></span><strong><%= f.dinero(totales.porMedio[k] || 0) %></strong></div><% }) %>
  </div></div></div>
</div>

<section class="card border-0 shadow-sm">
  <div class="card-body p-4">
    <% if (!filas.length) { %><p class="text-body-secondary mb-0">No hay movimientos con esos filtros.</p><% } else { %>
    <% if (recortado) { %><div class="alert alert-info small">Se muestran los 500 más recientes; acota las fechas para ver el resto.</div><% } %>
    <div class="table-responsive">
      <table class="table table-sm align-middle mb-0" id="tabla-movimientos">
        <thead><tr><th>Fecha</th><th>Caja</th><th>Tipo</th><th>Concepto</th><th>Persona</th><th>Medio</th><th>Atendió</th><th class="text-end">Monto</th></tr></thead>
        <tbody>
          <% filas.forEach(m => { %>
          <tr>
            <td class="text-nowrap small"><%= f.fechaCorta(m.creado_en) %></td>
            <td class="small"><%= m.caja.split('—')[0] %></td>
            <td><span class="badge text-bg-light border"><%= m.tipo_texto %></span></td>
            <td><%= m.concepto_texto %><div class="small text-body-secondary"><%= m.referencia %></div></td>
            <td class="small"><%= m.persona %></td>
            <td class="small"><%= medios[m.medio] %></td>
            <td class="small"><%= m.usuario %></td>
            <td class="text-end text-nowrap fw-semibold <%= m.monto < 0 ? 'text-danger' : '' %>"><%= m.monto < 0 ? '−' + f.dinero(-m.monto) : f.dinero(m.monto) %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</section>

<%- include('../partials/pie') %>
