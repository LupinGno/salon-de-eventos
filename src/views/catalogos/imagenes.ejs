<%- include('../partials/encabezado') %>

<div class="pt-4 pb-2 mb-3 border-bottom">
  <h1 class="h3 mb-0">Imágenes</h1>
  <p class="text-body-secondary mb-0">Una misma imagen puede usarse en varios productos y estilos (ej. la misma pizza para todos los estilos).</p>
</div>

<%- include('_nav') %>
<%- include('../partials/errores', { errores }) %>

<div class="card border-0 shadow-sm mb-4">
  <div class="card-body p-4">
    <h2 class="h6 text-uppercase texto-seccion mb-3">Subir imagen</h2>
    <form action="/catalogos/imagenes" method="post" enctype="multipart/form-data" class="row g-2 align-items-end">
      <div class="col-md-4">
        <label class="form-label small mb-0" for="nombre">Nombre</label>
        <input id="nombre" name="nombre" class="form-control" maxlength="80" required placeholder="Ej. Hamburguesa doble">
      </div>
      <div class="col-md-5">
        <label class="form-label small mb-0" for="archivo">Archivo (JPG, PNG, WEBP o GIF, máx. 2 MB)</label>
        <input id="archivo" name="archivo" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif" required>
      </div>
      <div class="col-md-3"><button class="btn btn-marca w-100"><i class="bi bi-upload"></i> Subir</button></div>
    </form>
  </div>
</div>

<div class="row g-3">
  <% imagenes.forEach(img => { %>
  <div class="col-6 col-md-4 col-xl-3">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body p-3 text-center">
        <img src="<%= img.archivo %>" alt="<%= img.nombre %>" class="img-galeria mb-2" loading="lazy">
        <div class="fw-semibold small text-truncate"><%= img.nombre %></div>
        <div class="small text-body-secondary mb-2">Usada en <%= img.usos %> elemento(s)</div>
        <form action="/catalogos/imagenes/<%= img.id %>/eliminar" method="post" class="form-confirmar" data-titulo="¿Eliminar imagen?" data-texto="Se eliminará &quot;<%= img.nombre %>&quot;.">
          <button class="btn btn-sm btn-outline-danger" <%= img.usos ? 'disabled title="Está en uso"' : '' %>><i class="bi bi-trash3"></i> Eliminar</button>
        </form>
      </div>
    </div>
  </div>
  <% }) %>
</div>

<%- include('../partials/pie') %>
