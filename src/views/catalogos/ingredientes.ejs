<%- include('../partials/encabezado') %>

<div class="pt-4 pb-2 mb-3 border-bottom">
  <h1 class="h3 mb-0">Ingredientes</h1>
  <p class="text-body-secondary mb-0">Catálogo general. En cada receta decides si un ingrediente es fijo, móvil o extra con costo.</p>
</div>

<%- include('_nav') %>
<%- include('../partials/errores', { errores }) %>

<div class="row g-4">
  <div class="col-lg-4">
    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">
        <h2 class="h6 text-uppercase texto-seccion mb-3">Nuevo ingrediente</h2>
        <form action="/catalogos/ingredientes" method="post" class="d-flex gap-2">
          <input name="nombre" class="form-control" maxlength="60" placeholder="Ej. Champiñones" required>
          <button class="btn btn-marca"><i class="bi bi-plus-lg"></i></button>
        </form>
      </div>
    </div>
  </div>
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead><tr><th>Nombre</th><th>Uso</th><th>Activo</th><th class="text-end"></th></tr></thead>
          <tbody>
            <% ingredientes.forEach(i => { %>
            <tr>
              <td>
                <form id="ing-<%= i.id %>" action="/catalogos/ingredientes/<%= i.id %>" method="post">
                  <input name="nombre" class="form-control form-control-sm" value="<%= i.nombre %>" maxlength="60" required aria-label="Nombre">
                </form>
              </td>
              <td class="small text-body-secondary text-nowrap"><%= i.en_recetas %> receta(s) · <%= i.como_extra %> extra(s)</td>
              <td><input form="ing-<%= i.id %>" class="form-check-input" type="checkbox" name="activo" value="1" <%= i.activo ? 'checked' : '' %> aria-label="Activo"></td>
              <td class="text-end text-nowrap">
                <button form="ing-<%= i.id %>" class="btn btn-sm btn-outline-primary" title="Guardar"><i class="bi bi-check-lg"></i></button>
                <form action="/catalogos/ingredientes/<%= i.id %>/eliminar" method="post" class="d-inline form-confirmar" data-titulo="¿Eliminar ingrediente?" data-texto="Se eliminará &quot;<%= i.nombre %>&quot;.">
                  <button class="btn btn-sm btn-outline-danger" title="Eliminar" <%= i.en_recetas + i.como_extra ? 'disabled' : '' %>><i class="bi bi-trash3"></i></button>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/pie') %>
