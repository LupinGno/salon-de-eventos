<%- include('../partials/encabezado') %>
<% const activas = mesas.filter(m => m.activo).length %>

<div class="pt-4 pb-2 mb-3 border-bottom">
  <h1 class="h3 mb-0">Mesas</h1>
  <p class="text-body-secondary mb-0"><%= activas %> activa(s) de <%= mesas.length %>. La caja lee las mesas en cada pedido, así que los cambios aplican sin reiniciar nada.</p>
</div>

<%- include('_nav') %>
<%- include('../partials/errores', { errores }) %>

<div class="card border-0 shadow-sm mb-4">
  <div class="card-body p-4">
    <h2 class="h6 text-uppercase texto-seccion mb-3">Añadir mesas</h2>
    <form action="/catalogos/mesas" method="post" class="d-flex flex-wrap gap-2 align-items-end">
      <div>
        <label class="form-label small mb-0" for="cantidad">Cuántas</label>
        <input id="cantidad" name="cantidad" type="number" min="1" max="50" value="3" class="form-control" style="max-width:110px" required>
      </div>
      <div>
        <label class="form-label small mb-0" for="capacidad">Personas por mesa</label>
        <input id="capacidad" name="capacidad" type="number" min="1" max="30" value="4" class="form-control" style="max-width:150px" required>
      </div>
      <button class="btn btn-marca"><i class="bi bi-plus-lg"></i> Añadir</button>
      <span class="small text-body-secondary">Se numeran después de la última (máximo <%= maxMesas %>).</span>
    </form>
  </div>
</div>

<div class="row g-3">
  <% mesas.forEach(m => { %>
  <div class="col-6 col-sm-4 col-md-3 col-xl-2">
    <div class="card border-0 shadow-sm h-100 tarjeta-mesa <%= m.activo ? '' : 'inactiva' %>">
      <div class="card-body p-3 text-center">
        <div class="numero-mesa"><%= m.numero %></div>
        <form action="/catalogos/mesas/<%= m.id %>" method="post" class="mt-2">
          <div class="input-group input-group-sm mb-2">
            <span class="input-group-text"><i class="bi bi-people"></i></span>
            <input name="capacidad" type="number" min="1" max="30" value="<%= m.capacidad %>" class="form-control" aria-label="Capacidad de la mesa <%= m.numero %>">
          </div>
          <div class="form-check form-switch d-inline-block mb-2">
            <input class="form-check-input" type="checkbox" role="switch" name="activo" value="1" id="mesa-<%= m.id %>" <%= m.activo ? 'checked' : '' %>>
            <label class="form-check-label small" for="mesa-<%= m.id %>">Activa</label>
          </div>
          <div class="d-flex gap-1 justify-content-center">
            <button class="btn btn-sm btn-outline-primary" title="Guardar"><i class="bi bi-check-lg"></i></button>
            <button class="btn btn-sm btn-outline-danger" formaction="/catalogos/mesas/<%= m.id %>/eliminar" title="Eliminar" data-pregunta="¿Eliminar la mesa <%= m.numero %>?"><i class="bi bi-trash3"></i></button>
          </div>
        </form>
      </div>
    </div>
  </div>
  <% }) %>
</div>

<%- include('../partials/pie') %>
