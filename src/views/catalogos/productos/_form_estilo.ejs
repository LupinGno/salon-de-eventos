<form action="<%= accion %>" method="post" enctype="multipart/form-data" class="row g-2 align-items-end">
  <div class="col-md-4">
    <label class="form-label small mb-0">Nombre</label>
    <input name="nombre" class="form-control form-control-sm" maxlength="60" required value="<%= e.nombre || '' %>">
  </div>
  <div class="col-md-5">
    <label class="form-label small mb-0">Descripción / ingredientes del estilo</label>
    <input name="descripcion" class="form-control form-control-sm" maxlength="255" value="<%= e.descripcion || '' %>">
  </div>
  <div class="col-md-3">
    <label class="form-label small mb-0">Precio extra</label>
    <div class="input-group input-group-sm"><span class="input-group-text">+$</span><input name="precio_extra" type="number" step="0.01" min="0" class="form-control" value="<%= e.precio_extra ?? 0 %>"></div>
  </div>
  <div class="col-md-4">
    <label class="form-label small mb-0">Temporada</label>
    <select name="temporada_id" class="form-select form-select-sm">
      <option value="">Todo el año</option>
      <% temporadas.forEach(t => { %><option value="<%= t.id %>" <%= Number(e.temporada_id) === t.id ? 'selected' : '' %>><%= t.nombre %></option><% }) %>
    </select>
  </div>
  <div class="col-md-4">
    <label class="form-label small mb-0">Imagen (galería)</label>
    <select name="imagen_id" class="form-select form-select-sm">
      <option value="">La misma del producto</option>
      <% imagenes.forEach(img => { %><option value="<%= img.id %>" <%= Number(e.imagen_id) === img.id ? 'selected' : '' %>><%= img.nombre %></option><% }) %>
    </select>
  </div>
  <div class="col-md-4">
    <label class="form-label small mb-0">o sube una</label>
    <input type="file" name="archivo" class="form-control form-control-sm" accept=".jpg,.jpeg,.png,.webp,.gif">
  </div>
  <div class="col-12 d-flex align-items-center gap-3">
    <div class="form-check form-switch mb-0">
      <input class="form-check-input" type="checkbox" role="switch" name="activo" value="1" id="activo-<%= e.id || 'nuevo' %>" <%= Number(e.activo) ? 'checked' : '' %>>
      <label class="form-check-label small" for="activo-<%= e.id || 'nuevo' %>">Activo</label>
    </div>
    <button class="btn btn-sm btn-marca"><i class="bi bi-check-lg"></i> <%= boton %></button>
  </div>
</form>
