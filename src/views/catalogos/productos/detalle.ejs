<%- include('../../partials/encabezado') %>
<% const p = producto %>

<div class="d-flex justify-content-between flex-wrap align-items-center pt-4 pb-2 mb-3 border-bottom gap-2">
  <div>
    <a href="/catalogos/productos?categoria=<%= p.categoria_id %>" class="small link-secondary text-decoration-none"><i class="bi bi-arrow-left"></i> <%= p.categoria %></a>
    <h1 class="h3 mb-0 mt-1"><%= p.nombre %></h1>
  </div>
  <div class="d-flex gap-2">
    <form action="/catalogos/productos/<%= p.id %>/estado" method="post">
      <button class="btn <%= p.activo ? 'btn-outline-secondary' : 'btn-outline-success' %>"><i class="bi bi-<%= p.activo ? 'pause-circle' : 'play-circle' %>"></i> <%= p.activo ? 'Dar de baja' : 'Activar' %></button>
    </form>
    <a href="/catalogos/productos/<%= p.id %>/editar" class="btn btn-marca"><i class="bi bi-pencil-square"></i> Modificar receta</a>
  </div>
</div>

<%- include('../../partials/errores', { errores }) %>

<div class="row g-4">
  <!-- Resumen -->
  <div class="col-lg-4">
    <div class="card border-0 shadow-sm">
      <div class="card-body p-4 text-center">
        <% if (p.imagen) { %><img src="<%= p.imagen %>" alt="" class="img-producto mb-3"><% } %>
        <div class="mb-2">
          <% if (p.vendible) { %><span class="badge text-bg-success">A la venta</span>
          <% } else { %><span class="badge text-bg-secondary">No disponible</span><div class="small text-body-secondary mt-1"><%= p.motivo %></div><% } %>
        </div>
        <p class="text-body-secondary small"><%= p.descripcion || '' %></p>
        <dl class="row text-start small mb-0">
          <dt class="col-6">Precio</dt><dd class="col-6"><%= p.tamanos.length ? 'desde ' : '' %><%= f.dinero(p.precio_desde) %></dd>
          <% if (p.piezas_por_orden) { %><dt class="col-6">Piezas por orden</dt><dd class="col-6"><%= p.piezas_por_orden %></dd><% } %>
          <dt class="col-6">Va a cocina</dt><dd class="col-6"><%= p.requiere_preparacion ? 'Sí' : 'No, se entrega al momento' %></dd>
          <dt class="col-6">Temporada</dt><dd class="col-6"><%= p.temporada ? `${p.temporada} (${f.fechaCorta(p.fecha_inicio)} – ${f.fechaCorta(p.fecha_fin)})` : 'Todo el año' %></dd>
          <dt class="col-6">Vigencia</dt><dd class="col-6"><%= p.vigente_hasta ? f.fechaCorta(p.vigente_hasta) : 'Sin límite' %></dd>
          <dt class="col-6">Quitar ingredientes</dt><dd class="col-6"><%= p.permite_quitar ? 'Permitido' : 'No (' + p.categoria + ')' %></dd>
        </dl>
      </div>
    </div>
  </div>

  <!-- Receta -->
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body p-4">
        <h2 class="h6 text-uppercase texto-seccion mb-3">Receta</h2>
        <div class="row g-3">
          <div class="col-md-4">
            <div class="small fw-semibold mb-1"><i class="bi bi-lock-fill"></i> Fijos</div>
            <% if (!p.fijos.length) { %><span class="small text-body-secondary">Ninguno</span><% } %>
            <% p.fijos.forEach(i => { %><span class="badge chip-fijo me-1 mb-1"><%= i.nombre %></span><% }) %>
          </div>
          <div class="col-md-4">
            <div class="small fw-semibold mb-1"><i class="bi bi-dash-circle"></i> Móviles (se quitan gratis)</div>
            <% if (!p.moviles.length) { %><span class="small text-body-secondary">Ninguno</span><% } %>
            <% p.moviles.forEach(i => { %><span class="badge chip-movil me-1 mb-1"><%= i.nombre %></span><% }) %>
          </div>
          <div class="col-md-4">
            <div class="small fw-semibold mb-1"><i class="bi bi-plus-circle"></i> Extras con costo</div>
            <% if (!p.extras.length) { %><span class="small text-body-secondary">Ninguno</span><% } %>
            <% p.extras.forEach(i => { %><span class="badge chip-extra me-1 mb-1"><%= i.nombre %> +<%= f.dinero(i.precio) %></span><% }) %>
          </div>
        </div>
      </div>
    </div>

    <!-- Estilos -->
    <div class="card border-0 shadow-sm mb-4" id="estilos">
      <div class="card-body p-4">
        <h2 class="h6 text-uppercase texto-seccion mb-1">Estilos o sabores</h2>
        <p class="small text-body-secondary">Ej. pizza italiana, alitas BBQ, frappé de fresa. Si no eliges imagen, usa la misma del producto.</p>
        <% if (p.estilos.length) { %>
        <div class="table-responsive">
          <table class="table table-sm align-middle">
            <thead><tr><th></th><th>Estilo</th><th>Precio extra</th><th class="d-none d-md-table-cell">Temporada</th><th>Estado</th><th></th></tr></thead>
            <tbody>
              <% p.estilos.forEach(e => { %>
              <tr>
                <td><% if (e.imagen) { %><img src="<%= e.imagen %>" alt="" class="miniatura-tabla"><% } %></td>
                <td><span class="fw-semibold"><%= e.nombre %></span><% if (e.descripcion) { %><br><small class="text-body-secondary"><%= e.descripcion %></small><% } %></td>
                <td><%= e.precio_extra > 0 ? '+' + f.dinero(e.precio_extra) : '—' %></td>
                <td class="d-none d-md-table-cell small"><%= e.temporada || 'Todo el año' %></td>
                <td><span class="badge <%= e.disponible ? 'text-bg-success' : 'text-bg-secondary' %>"><%= e.disponible ? 'Disponible' : (e.activo ? 'Fuera de temporada' : 'Inactivo') %></span></td>
                <td class="text-end text-nowrap">
                  <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#editar-estilo-<%= e.id %>" title="Modificar"><i class="bi bi-pencil-square"></i></button>
                  <form action="/catalogos/productos/<%= p.id %>/estilos/<%= e.id %>/eliminar" method="post" class="d-inline form-confirmar" data-titulo="¿Eliminar estilo?" data-texto="Se eliminará el estilo &quot;<%= e.nombre %>&quot;.">
                    <button class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash3"></i></button>
                  </form>
                </td>
              </tr>
              <tr class="collapse" id="editar-estilo-<%= e.id %>">
                <td colspan="6" class="bg-transparent">
                  <%- include('_form_estilo', { accion: `/catalogos/productos/${p.id}/estilos/${e.id}`, e, temporadas, imagenes, boton: 'Guardar estilo' }) %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% } %>
        <details <%= p.estilos.length ? '' : 'open' %>>
          <summary class="btn btn-sm btn-outline-primary"><i class="bi bi-plus-lg"></i> Agregar estilo</summary>
          <div class="mt-3">
            <%- include('_form_estilo', { accion: `/catalogos/productos/${p.id}/estilos`, e: { activo: 1, precio_extra: 0 }, temporadas, imagenes, boton: 'Agregar estilo' }) %>
          </div>
        </details>
      </div>
    </div>

    <!-- Tamaños -->
    <div class="card border-0 shadow-sm" id="tamanos">
      <div class="card-body p-4">
        <h2 class="h6 text-uppercase texto-seccion mb-1">Tamaños</h2>
        <p class="small text-body-secondary">Si el producto tiene tamaños, cada uno lleva su precio (ej. pizza chica, mediana, familiar).</p>
        <% p.tamanos.forEach(t => { %>
          <form action="/catalogos/productos/<%= p.id %>/tamanos/<%= t.id %>" method="post" class="d-flex flex-wrap gap-2 align-items-center mb-2">
            <input name="nombre" class="form-control form-control-sm w-auto" value="<%= t.nombre %>" maxlength="40" required aria-label="Nombre del tamaño">
            <div class="input-group input-group-sm w-auto"><span class="input-group-text">$</span><input name="precio" type="number" step="0.01" min="0.5" class="form-control" value="<%= t.precio %>" required aria-label="Precio" style="max-width:110px"></div>
            <input name="orden" type="number" min="0" max="99" class="form-control form-control-sm" value="<%= t.orden %>" style="max-width:70px" title="Orden" aria-label="Orden">
            <button class="btn btn-sm btn-outline-primary" title="Guardar"><i class="bi bi-check-lg"></i></button>
            <button class="btn btn-sm btn-outline-danger" formaction="/catalogos/productos/<%= p.id %>/tamanos/<%= t.id %>/eliminar" title="Eliminar"><i class="bi bi-trash3"></i></button>
          </form>
        <% }) %>
        <form action="/catalogos/productos/<%= p.id %>/tamanos" method="post" class="d-flex flex-wrap gap-2 align-items-center mt-3">
          <input name="nombre" class="form-control form-control-sm w-auto" placeholder="Nuevo tamaño" maxlength="40" required>
          <div class="input-group input-group-sm w-auto"><span class="input-group-text">$</span><input name="precio" type="number" step="0.01" min="0.5" class="form-control" placeholder="Precio" required style="max-width:110px"></div>
          <input name="orden" type="number" min="0" max="99" class="form-control form-control-sm" value="<%= p.tamanos.length + 1 %>" style="max-width:70px" title="Orden">
          <button class="btn btn-sm btn-marca"><i class="bi bi-plus-lg"></i> Agregar</button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/pie') %>
