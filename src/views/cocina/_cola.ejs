<% if (!comandas.length) { %>
  <div class="col-12">
    <div class="card border-0 shadow-sm"><div class="card-body p-5 text-center text-body-secondary">
      <i class="bi bi-cup-hot fs-1 d-block mb-2"></i>No hay comandas pendientes. Las nuevas aparecen aquí solas.
    </div></div>
  </div>
<% } %>
<% comandas.forEach((c, i) => { const prisa = c.minutos >= 20 ? 'danger' : c.minutos >= 10 ? 'warning' : 'success' %>
<div class="col-md-6 col-xl-4 col-xxl-3">
  <div class="card border-0 shadow-sm h-100 tarjeta-cocina <%= i === 0 ? 'primera' : '' %>">
    <div class="card-header d-flex flex-wrap align-items-center gap-2 bg-transparent">
      <span class="badge rounded-pill text-bg-dark" title="Lugar en la cola"><%= i + 1 %>°</span>
      <span class="fs-4 fw-bold">#<%= c.folio %></span>
      <span class="badge <%= c.para_llevar ? 'text-bg-primary' : 'text-bg-light border' %> fs-6"><%= c.para_llevar ? 'PARA LLEVAR' : `Mesa ${c.mesa}` %></span>
      <span class="ms-auto badge text-bg-<%= prisa %>" title="Minutos desde que se pidió"><i class="bi bi-clock"></i> <%= c.minutos %> min</span>
    </div>
    <div class="card-body pt-2">
      <div class="small text-body-secondary mb-2"><i class="bi bi-person"></i> <%= c.cliente %> · <%= String(c.creada_en).slice(11, 16) %></div>
      <ul class="list-unstyled mb-0">
        <% c.articulos.forEach(a => { %>
        <li class="articulo-cocina <%= a.estado %>">
          <div class="d-flex justify-content-between gap-2 align-items-start">
            <div>
              <div class="fw-semibold"><%= a.descripcion %></div>
              <% if (a.piezas) { %><div class="small"><%= a.piezas %> piezas</div><% } %>
              <% a.quitar.forEach(n => { %><div class="mod-quitar">SIN <%= n %></div><% }) %>
              <% a.extras.forEach(n => { %><div class="mod-extra">+ <%= n %> extra</div><% }) %>
            </div>
            <div class="d-flex flex-column gap-1 text-nowrap">
              <% if (a.estado === 'pendiente') { %>
                <form method="post" action="/cocina/articulos/<%= a.id %>/preparar" data-ajax>
                  <button class="btn btn-sm btn-outline-primary w-100"><i class="bi bi-fire"></i> Preparar</button>
                </form>
              <% } else { %>
                <span class="badge estado-en_preparacion">Preparando</span>
              <% } %>
              <form method="post" action="/cocina/articulos/<%= a.id %>/lista" data-ajax>
                <button class="btn btn-sm btn-outline-success w-100"><i class="bi bi-check2"></i> Listo</button>
              </form>
            </div>
          </div>
        </li>
        <% }) %>
      </ul>
    </div>
    <div class="card-footer bg-transparent border-0 pt-0">
      <form method="post" action="/cocina/comandas/<%= c.id %>/lista" data-ajax>
        <button class="btn btn-marca w-100"><i class="bi bi-bell"></i> Toda la comanda lista</button>
      </form>
    </div>
  </div>
</div>
<% }) %>
