<%- include('partials/encabezado') %>

<div class="pt-4 pb-2 mb-4 border-bottom">
    <h1 class="h3 mb-0"><i class="bi bi-<%= modulo.icono %>"></i> <%= modulo.titulo %></h1>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-5 text-center">
        <div class="icono-modulo icono-grande mx-auto mb-3"><i class="bi bi-cone-striped"></i></div>
        <h2 class="h5">Módulo en construcción</h2>
        <p class="text-body-secondary mb-1"><%= modulo.descripcion %></p>
        <p class="mb-4"><span class="badge text-bg-light border">Entrega: <%= modulo.entrega %></span></p>
        <p class="small text-body-secondary mb-0">
            Tienes acceso porque tu rol (<strong><%= usuario.rol %></strong>) está autorizado para este módulo.
        </p>
    </div>
</div>

<%- include('partials/pie') %>
