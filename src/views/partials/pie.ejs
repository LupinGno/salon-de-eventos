        </main>
    </div>
</div>
<%- include('scripts') %>
<% if (usuario && usuario.modulos && ['cocina', 'caja-snacks', 'cajas'].some(m => usuario.modulos.includes(m))) { %>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/tiempo_real.js"></script>
<% } %>
<% if (typeof scriptsExtra !== 'undefined') { scriptsExtra.forEach(s => { %><script src="<%= s %>"></script>
<% }) } %>
</body>
</html>
