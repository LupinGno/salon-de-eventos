<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head', { titulo: 'Crear cuenta' }) %>
</head>
<body class="pantalla-acceso d-flex align-items-center py-4">
    <%- include('partials/burbujas') %>
    <main class="form-acceso form-acceso-ancho w-100 m-auto">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-4 p-sm-5">
                <div class="text-center mb-4">
                    <div class="logo-circulo mx-auto mb-3"><i class="bi bi-person-plus-fill"></i></div>
                    <h1 class="h4 mb-1">Crear cuenta</h1>
                    <p class="text-body-secondary small mb-0">Llena todos los campos</p>
                </div>

                <%- include('partials/errores', { errores }) %>

                <form action="/register" method="post" class="needs-validation" novalidate>
                    <div class="mb-3">
                        <label for="nombre" class="form-label">Nombre completo</label>
                        <input type="text" id="nombre" name="nombre" class="form-control" maxlength="100"
                               value="<%= datos.nombre || '' %>" required>
                        <div class="invalid-feedback">Escribe tu nombre.</div>
                    </div>
                    <div class="mb-3">
                        <label for="usuario" class="form-label">Usuario</label>
                        <input type="text" id="usuario" name="usuario" class="form-control" autocomplete="username"
                               pattern="[a-zA-Z0-9._\-]{3,30}" value="<%= datos.usuario || '' %>" required>
                        <div class="form-text">3 a 30 caracteres, sin espacios.</div>
                        <div class="invalid-feedback">Usuario inválido: de 3 a 30 letras, números, punto o guion.</div>
                    </div>
                    <div class="mb-3">
                        <label for="password" class="form-label">Contraseña</label>
                        <input type="password" id="password" name="password" class="form-control" autocomplete="new-password"
                               minlength="8" maxlength="72" pattern="(?=.*[A-Za-z])(?=.*[0-9]).{8,72}" required>
                        <div class="form-text">Mínimo 8 caracteres, con al menos una letra y un número.</div>
                        <div class="invalid-feedback">Mínimo 8 caracteres, con letra y número.</div>
                    </div>
                    <div class="mb-4">
                        <label for="confirmar" class="form-label">Verificar contraseña</label>
                        <input type="password" id="confirmar" name="confirmar" class="form-control" autocomplete="new-password"
                               data-confirmar="password" required>
                        <div class="invalid-feedback">Las contraseñas no coinciden.</div>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="/login" class="btn btn-outline-secondary w-50">Cancelar</a>
                        <button type="submit" class="btn btn-marca w-50">Registrarme</button>
                    </div>
                </form>
            </div>
        </div>
    </main>
    <%- include('partials/scripts') %>
</body>
</html>
