<%
const seccionesSalones = [
  ['/salones', 'Disponibilidad', 'calendar2-week', r => r === '/salones' || r === '/salones/reservar'],
  ['/salones/reservas', 'Reservas', 'journal-bookmark', r => r.startsWith('/salones/reservas')]
]
%>
<nav class="nav nav-pills nav-catalogo gap-1 mb-4 flex-nowrap overflow-auto pb-1" aria-label="Secciones de renta de salones">
  <% seccionesSalones.forEach(([ruta, nombre, icono, activa]) => { %>
    <a class="nav-link text-nowrap <%= activa(rutaActual) ? 'active' : '' %>" href="<%= ruta %>"><i class="bi bi-<%= icono %>"></i> <%= nombre %></a>
  <% }) %>
</nav>
