<%- include('../partials/encabezado') %>

<% const editar = modo === 'editar' %>

<div class="pt-4 pb-2 mb-4 border-bottom">
    <a href="/usuarios" class="small link-secondary text-decoration-none"><i class="bi bi-arrow-left"></i> Usuarios</a>
    <h1 class="h3 mb-0 mt-1"><%= titulo %></h1>
</div>

<div class="row">
    <div class="col-lg-8 col-xl-6">
        <%- include('../partials/errores', { errores }) %>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form action="<%= editar ? '/usuarios/' + datos.id : '/usuarios' %>" method="post" class="needs-validation" novalidate>
                    <div class="mb-3">
                        <label for="nombre" class="form-label">Nombre completo</label>
                        <input type="text" id="nombre" name="nombre" class="form-control" maxlength="100"
                               value="<%= datos.nombre || '' %>" required>
                        <div class="invalid-feedback">Escribe el nombre.</div>
                    </div>

                    <div class="mb-3">
                        <label for="usuario" class="form-label">Usuario</label>
                        <input type="text" id="usuario" name="usuario" class="form-control" autocomplete="off"
                               pattern="[a-zA-Z0-9._\-]{3,30}" value="<%= datos.usuario || '' %>" required>
                        <div class="invalid-feedback">De 3 a 30 letras, números, punto o guion, sin espacios.</div>
                    </div>

                    <div class="mb-3">
                        <label for="rol_id" class="form-label">Rol</label>
                        <select id="rol_id" name="rol_id" class="form-select" required>
                            <option value="">Selecciona un rol…</option>
                            <% roles.forEach(r => { %>
                            <option value="<%= r.id %>" <%= Number(datos.rol_id) === r.id ? 'selected' : '' %>>
                                <%= r.nombre %> — <%= r.descripcion %>
                            </option>
                            <% }) %>
                        </select>
                        <div class="invalid-feedback">Selecciona un rol.</div>
                    </div>

                    <div class="row g-3 mb-1">
                        <div class="col-sm-6">
                            <label for="password" class="form-label">Contraseña</label>
                            <input type="password" id="password" name="password" class="form-control" autocomplete="new-password"
                                   minlength="8" maxlength="72" pattern="(?=.*[A-Za-z])(?=.*[0-9]).{8,72}" <%= editar ? '' : 'required' %>>
                            <div class="invalid-feedback">Mínimo 8 caracteres, con letra y número.</div>
                        </div>
                        <div class="col-sm-6">
                            <label for="confirmar" class="form-label">Verificar contraseña</label>
                            <input type="password" id="confirmar" name="confirmar" class="form-control" autocomplete="new-password"
                                   data-confirmar="password" <%= editar ? '' : 'required' %>>
                            <div class="invalid-feedback">Las contraseñas no coinciden.</div>
                        </div>
                    </div>
                    <div class="form-text mb-3">
                        <% if (editar) { %>Déjala vacía para conservar la contraseña actual.<% } else { %>Mínimo 8 caracteres, con al menos una letra y un número.<% } %>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" role="switch" id="activo" name="activo" value="1"
                               <%= Number(datos.activo) ? 'checked' : '' %>>
                        <label class="form-check-label" for="activo">Usuario activo (puede iniciar sesión)</label>
                    </div>

                    <div class="d-flex gap-2">
                        <a href="/usuarios" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-marca">
                            <i class="bi bi-check-lg"></i> <%= editar ? 'Guardar cambios' : 'Registrar usuario' %>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/pie') %>
