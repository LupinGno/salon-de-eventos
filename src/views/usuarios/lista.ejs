<%- include('../partials/encabezado') %>

<div class="d-flex justify-content-between flex-wrap align-items-center pt-4 pb-2 mb-4 border-bottom gap-2">
    <div>
        <h1 class="h3 mb-0">Usuarios y roles</h1>
        <p class="text-body-secondary mb-0"><%= usuarios.length %> usuario(s) registrados</p>
    </div>
    <a href="/usuarios/nuevo" class="btn btn-marca">
        <i class="bi bi-person-plus-fill"></i> Registrar usuarios aquí
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nombre</th>
                    <th>Usuario</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th class="d-none d-lg-table-cell">Alta</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <% usuarios.forEach(u => { %>
                <tr>
                    <td><%= u.nombre %><% if (u.id === usuario.id) { %> <span class="badge text-bg-info">tú</span><% } %></td>
                    <td><code><%= u.usuario %></code></td>
                    <td><%= u.rol %></td>
                    <td>
                        <% if (u.activo) { %><span class="badge text-bg-success">Activo</span>
                        <% } else { %><span class="badge text-bg-secondary">Inactivo</span><% } %>
                    </td>
                    <td class="d-none d-lg-table-cell small text-body-secondary">
                        <%= new Date(u.creado_en).toLocaleDateString('es-MX') %>
                    </td>
                    <td class="text-end text-nowrap">
                        <a href="/usuarios/<%= u.id %>/editar" class="btn btn-sm btn-outline-primary" title="Modificar">
                            <i class="bi bi-pencil-square"></i><span class="d-none d-md-inline"> Modificar</span>
                        </a>
                        <% if (u.id !== usuario.id) { %>
                        <form action="/usuarios/<%= u.id %>/eliminar" method="post" class="d-inline form-eliminar"
                              data-nombre="<%= u.nombre %>">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                <i class="bi bi-trash3"></i><span class="d-none d-md-inline"> Eliminar</span>
                            </button>
                        </form>
                        <% } %>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../partials/pie') %>
